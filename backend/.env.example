NODE_ENV=development
PORT=3000

# Required
DATABASE_URL=postgresql://projectflow:change-me@localhost:5432/projectflow
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Comma-separated origins are supported.
FRONTEND_URL=http://localhost:5173,http://localhost:8080

# Redis-backed authentication sessions
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional error reporting
SENTRY_DSN=

# Optional web push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional seed account. The seed also creates development demo users.
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=change-me-superadmin-password

# Optional payment-provider fallbacks. Providers may instead be configured by
# a super-admin in the application.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
