{
  "name": "@project-flow/core-backend",
  "version": "0.1.0",
  "description": "Open-source Project Flow Core NestJS GraphQL API",
  "author": "dimastriann",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"vitest.config.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"vitest.config.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config test/vitest-e2e.config.ts"
  },
  "prisma": {
    "seed": "node node_modules/ts-node/dist/bin.js -r tsconfig-paths/register prisma/seed.ts"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1068.0",
    "@nestjs-modules/ioredis": "^2.2.1",
    "@nestjs/apollo": "^14.2.0",
    "@nestjs/common": "12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "12.4.0",
    "@nestjs/graphql": "14.2.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^12.0.1",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/platform-socket.io": "^12.4.0",
    "@nestjs/schedule": "^12.0.3",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.4.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@types/passport-jwt": "^4.0.1",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "graphql": "^16.11.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-upload-ts": "^2.1.3",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "link-preview-js": "5.0.0",
    "midtrans-client": "^1.4.3",
    "otplib": "^13.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "ssh2-sftp-client": "^12.1.1",
    "stripe": "^22.2.0",
    "web-push": "^3.6.7",
    "xendit-node": "^7.0.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^12.4.0",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/archiver": "^8.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/midtrans-client": "^1.4.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "prisma": "7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@protobufjs/utf8": "1.1.2",
    "deepmerge-ts": "8.0.2",
    "lodash": "4.18.1",
    "mysql2": "3.24.5",
    "picomatch": "4.0.7",
    "readdir-glob": {
      "minimatch": "11.0.5"
    }
  }
}
